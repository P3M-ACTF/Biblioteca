 DNS["DNS · Nombres"] --> UDP["UDP · Datagramas"]
 DNS --> TCP
 DHCP["DHCP · Configuración dinámica"] --> UDP
 SNMP["SNMP · Gestión"] --> UDP
 HTTP3["HTTP/3"] --> QUIC["QUIC"] --> UDP
 TCP --> IP["IPv4 / IPv6"]
 UDP --> IP
 IP --> ETH["Ethernet / Wi-Fi"]
 ETH --> PHY["Capa física"]
 OSPF["OSPF / BGP / RIP"] --> IP
